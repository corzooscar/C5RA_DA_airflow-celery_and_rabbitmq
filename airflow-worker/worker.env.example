# Copia este archivo como ".env" en la carpeta de CADA WORKER, junto a docker-compose.worker.yaml

# En Linux pon el resultado de:  id -u
AIRFLOW_UID=50000

# IP del computador master en tu red
MASTER_HOST=10.1.21.22

# Unico por computador: worker-1, worker-2 o worker-3.
# Debe corresponder a la IP que pusiste en WORKER_N_IP en el .env del master.
WORKER_NAME=worker-1

# --- Copia estos valores TAL CUAL del .env del master ---
FERNET_KEY=_-gTBPuSUFH4GrpVahPT9YIFoGg3PaIC-nbbQhJumiY=
